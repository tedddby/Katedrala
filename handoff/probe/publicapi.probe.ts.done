import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/publicapi.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

it("probe", async () => {
  const out: string[] = [];
  try {
    const analysis = await analyzeStructure({ source: fixtureSource("clean-architecture"), cache: false, concurrency: 1 });
    const { document, model } = analysis;
    const inDomain = (p: string | undefined) => p !== undefined && p.startsWith("file:src/domain/");
    const byTarget = new Map<string, Set<string>>();
    for (const e of document.edges) {
      const s = model.fileOf(e.source);
      const t = model.fileOf(e.target);
      if (!inDomain(t) || inDomain(s) || s === undefined || t === undefined) continue;
      const via = e.provenance.some((p) => (p.via ?? []).length > 0);
      const key = `${t}`;
      if (!byTarget.has(key)) byTarget.set(key, new Set());
      byTarget.get(key)!.add(`${e.kind}${via ? "(via)" : ""} from ${s}`);
    }
    for (const [t, set] of [...byTarget].sort()) {
      out.push(`${t}`);
      for (const x of [...set].sort()) out.push(`   ${x}`);
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
