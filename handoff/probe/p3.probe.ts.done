import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/p3.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

// Feature-organized fixtures only (no stem units): prior = first directory under src (root for src/*).
const KIND: Record<string, Record<string, string>> = {
  "circular-dependencies": { "src": "root", "src/api": "layer", "src/demo": "feature", "src/notifications": "feature", "src/people": "feature", "src/shared": "shared", "src/workflow": "feature" },
  "typescript-features": { "src": "root", "src/billing": "feature", "src/customers": "feature", "src/orders": "feature", "src/shared": "shared", "src/ui": "layer", "src/utils": "shared" },
  "ambiguous-boundaries": { "src": "root", "src/cart": "feature", "src/catalog": "feature", "src/checkout": "feature", "src/common": "shared" },
  "tangled-architecture": { "src": "root", "src/cart": "feature", "src/catalog": "feature", "src/checkout": "feature", "src/customers": "feature", "src/inventory": "feature", "src/lib": "shared" },
  "javascript-commonjs": { "src": "root", "src/lib": "shared", "src/plugins": "feature", "src/routes": "layer", "src/services": "layer", "src/store": "layer", "src/views": "layer" },
  "fastify-app": { "src": "root", "src/clients": "layer", "src/handlers": "layer", "src/hooks": "layer", "src/plugins": "feature", "src/repositories": "layer", "src/routes": "layer", "src/schemas": "layer", "src/services": "layer" },
};

function prior(path: string): string {
  const rest = path.replace(/^src\//, "");
  return rest.includes("/") ? `src/${rest.slice(0, rest.indexOf("/"))}` : "src";
}

it("probe", async () => {
  const out: string[] = [];
  try {
    for (const name of Object.keys(KIND)) {
      const analysis = await analyzeStructure({ source: fixtureSource(name), cache: false, concurrency: 1 });
      const { model, document } = analysis;
      const p = model.projection({ level: "file", fileRoles: new Set(["source"] as const) });
      const n = p.nodes.length;
      const path = (i: number) => p.nodes[i]!.slice(5);
      const unit = (i: number) => prior(path(i));
      const kind = (i: number) => KIND[name]![unit(i)] ?? "feature";
      const w = (s: number, t: number) => (p.edgeInfo(s, t)!.runtimeEdgeCount > 0 ? 1 : 0.5);
      const entry = new Set(document.entryPoints.map((e) => model.fileOf(e.entity)));
      const utilities = (excluded: Set<number>) => {
        const found = new Set<number>();
        for (let f = 0; f < n; f++) {
          if (excluded.has(f)) continue;
          const units = new Set<string>();
          for (const s of p.graph.predecessors(f)) if (!excluded.has(s)) units.add(unit(s));
          units.delete(unit(f));
          const min = kind(f) === "shared" || kind(f) === "root" ? 2 : 3;
          if (units.size >= min) found.add(f);
        }
        return found;
      };
      const util0 = utilities(new Set());
      const orch = new Set<number>();
      let changed = true;
      while (changed) {
        changed = false;
        for (let f = 0; f < n; f++) {
          if (orch.has(f) || util0.has(f)) continue;
          const deps = [...p.graph.predecessors(f)].filter((s) => !orch.has(s));
          const outside = deps.filter((s) => unit(s) !== unit(f));
          if (entry.has(p.nodes[f] as never) && deps.length === 0) { orch.add(f); changed = true; continue; }
          if (outside.length > 0) continue;
          const o = new Map<string, number>();
          for (const t of p.graph.successors(f)) if (!util0.has(t)) o.set(unit(t), (o.get(unit(t)) ?? 0) + w(f, t));
          const total = [...o.values()].reduce((a, b) => a + b, 0);
          const others = [...o.keys()].filter((k) => k !== unit(f));
          const max = Math.max(0, ...o.values());
          const own = o.get(unit(f)) ?? 0;
          if (total === 0 || others.length < 2 || max > 0.5 * total || own > 0.25 * total) continue;
          orch.add(f);
          changed = true;
        }
      }
      const util = utilities(orch);
      out.push(`=== ${name}`);
      out.push(`  orchestrators: ${[...orch].map(path).sort().join(", ")}`);
      out.push(`  utilities: ${[...util].map(path).sort().join(", ")}`);
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
