import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/decl.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

it("probe", async () => {
  const out: string[] = [];
  try {
    for (const name of ["express-app", "typescript-features", "nestjs-app", "fastify-app", "high-fan-out", "high-fan-in", "javascript-commonjs", "simple-dependencies", "circular-dependencies"]) {
      if (!existsSync(join(FIXTURES, name, "expected.json"))) continue;
      const analysis = await analyzeStructure({ source: fixtureSource(name), cache: false, concurrency: 1 });
      const { document, model } = analysis;
      out.push(`=== ${name}`);
      const decl = new Set(document.files.filter((f) => f.role === "declaration" || f.role === "test").map((f) => f.id));
      for (const e of document.edges) {
        const s = model.fileOf(e.source);
        const t = model.fileOf(e.target);
        if ((t !== undefined && decl.has(t)) || (s !== undefined && decl.has(s))) {
          out.push(`  ${e.kind} ${e.source} -> ${e.target} typeOnly=${e.typeOnly} conf=${e.confidence}`);
        }
      }
      // exported classes per file
      const classes = document.symbols.filter((s) => s.kind === "class" && s.exported && s.parent === undefined).map((s) => s.id);
      out.push(`  exported top-level classes: ${classes.length}`);
      for (const c of classes) out.push(`    ${c}`);
      // file pair graph stats
      const p = model.projection({ level: "file", fileRoles: new Set(["source"] as const) });
      const reexp: string[] = [];
      for (let u = 0; u < p.nodes.length; u++) {
        let total = 0;
        let re = 0;
        for (let i = p.graph.outOffsets[u]!; i < p.graph.outOffsets[u + 1]!; i++) {
          const info = p.edgeInfoAt(i);
          total++;
          if ((info?.kindCounts["re-exports"] ?? 0) > 0) re++;
        }
        if (re > 0) reexp.push(`${p.nodes[u]} re-exports ${re}/${total}`);
      }
      out.push(`  facade candidates: ${reexp.join("; ")}`);
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
