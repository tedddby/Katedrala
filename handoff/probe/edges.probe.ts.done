import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/edges.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

it("probe", async () => {
  const out: string[] = [];
  try {
    for (const name of readdirSync(FIXTURES).sort()) {
      if (!existsSync(join(FIXTURES, name, "expected.json"))) continue;
      const analysis = await analyzeStructure({ source: fixtureSource(name), cache: false, concurrency: 1 });
      const { model, document } = analysis;
      const roles = new Set(["source", "declaration"] as const);
      const all = model.projection({ level: "file", fileRoles: roles });
      const imp = model.projection({ level: "file", edgeKinds: new Set(["imports", "re-exports"] as const), fileRoles: roles });
      const pairs = (p: typeof all) => {
        const s = new Set<string>();
        for (const [u, v] of p.graph.edges()) s.add(`${p.nodes[u]} -> ${p.nodes[v]}`);
        return s;
      };
      const a = pairs(all);
      const b = pairs(imp);
      const extra = [...a].filter((x) => !b.has(x));
      out.push(`=== ${name}: file pairs all-kinds ${a.size}, imports ${b.size}, extra (no import) ${extra.length}`);
      for (const x of extra) {
        const [s, t] = x.split(" -> ");
        const info = all.edgeInfo(all.indexOf(s as never), all.indexOf(t as never));
        out.push(`   ${x.replaceAll("file:", "")}  ${JSON.stringify(info?.kindCounts)} runtime=${info?.runtimeEdgeCount}`);
      }
      const low = document.edges.filter((e) => e.confidence < 0.5);
      out.push(`   low-confidence edges: ${low.length}`);
      for (const e of low.slice(0, 5)) out.push(`     ${e.kind} ${e.source} -> ${e.target} ${e.confidence}`);
      const roleCounts: Record<string, number> = {};
      for (const f of document.files) roleCounts[f.role] = (roleCounts[f.role] ?? 0) + 1;
      out.push(`   roles ${JSON.stringify(roleCounts)} packages ${document.packages.map((p) => `${p.id}=${p.name}`).join(" ")} entryPoints ${document.entryPoints.map((e) => `${e.entity}:${e.kind}`).join(" ")}`);
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
