import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/orch.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

/** Prior unit of a file in a simple fixture: first directory below src, or "src" for root files. */
function prior(path: string): string {
  const rest = path.replace(/^src\//, "");
  return rest.includes("/") ? `src/${rest.slice(0, rest.indexOf("/"))}` : "src";
}

it("probe", async () => {
  const out: string[] = [];
  try {
    for (const name of ["clean-architecture", "ambiguous-boundaries", "layered-architecture", "javascript-commonjs", "typescript-features", "dependency-violations", "nestjs-app", "express-app", "fastify-app", "circular-dependencies", "high-fan-in"]) {
      const analysis = await analyzeStructure({ source: fixtureSource(name), cache: false, concurrency: 1 });
      const { model } = analysis;
      const p = model.projection({ level: "file", fileRoles: new Set(["source"] as const) });
      out.push(`=== ${name}`);
      for (let u = 0; u < p.nodes.length; u++) {
        const path = p.nodes[u]!.slice(5);
        const own = prior(path);
        const w = new Map<string, number>();
        let total = 0;
        for (let i = p.graph.outOffsets[u]!; i < p.graph.outOffsets[u + 1]!; i++) {
          const info = p.edgeInfoAt(i)!;
          const t = p.nodes[p.graph.outTargets[i]!]!.slice(5);
          const weight = info.runtimeEdgeCount > 0 ? 1 : 0.5;
          const k = prior(t);
          w.set(k, (w.get(k) ?? 0) + weight);
          total += weight;
        }
        const others = [...w.keys()].filter((k) => k !== own);
        const max = Math.max(0, ...w.values());
        const ownShare = (w.get(own) ?? 0) / (total || 1);
        const dependents = [...p.graph.predecessors(u)].map((s) => p.nodes[s]!.slice(5));
        const outside = dependents.filter((d) => prior(d) !== own);
        const shape = total > 0 && others.length >= 2 && max <= 0.5 * total && ownShare <= 0.25;
        if (shape || dependents.length === 0) {
          out.push(`  ${path} [${own}] shape=${shape} out=${JSON.stringify(Object.fromEntries(w))} dependents=${dependents.join(",")} outsideDependents=${outside.join(",")}`);
        }
      }
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
