import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { InMemorySource } from "@katedrala/core";
import { analyzeStructure } from "@katedrala/engine";

const FIXTURES = "C:/Users/Awab/Desktop/PROJECTS/Katedrala/fixtures";
const OUT = "C:/Users/Awab/AppData/Local/Temp/claude/c--Users-Awab-Desktop-PROJECTS-Katedrala/f7609e3b-1ca5-4e98-a818-ae87ef209574/scratchpad/probe/weights.out.txt";
function fixtureSource(name: string): InMemorySource {
  const files: Record<string, Uint8Array> = {};
  const walk = (directory: string, prefix: string): void => {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = prefix === "" ? entry.name : `${prefix}/${entry.name}`;
      if (entry.isDirectory()) walk(join(directory, entry.name), path);
      else if (prefix !== "" || (entry.name !== "README.md" && entry.name !== "expected.json")) {
        files[path] = readFileSync(join(directory, entry.name));
      }
    }
  };
  walk(join(FIXTURES, name), "");
  return new InMemorySource({ files });
}

it("probe", async () => {
  const out: string[] = [];
  try {
    for (const [name, focus] of [
      ["high-fan-out", ["src/orchestrator.ts", "src/main.ts"]],
      ["layered-architecture", ["src/services/payment.service.ts", "src/main.ts"]],
      ["ambiguous-boundaries", ["src/catalog/price-calculator.ts", "src/cart/shipping-estimator.ts", "src/checkout/stock-availability.ts", "src/catalog/product.ts", "src/server.ts"]],
    ] as const) {
      const analysis = await analyzeStructure({ source: fixtureSource(name), cache: false, concurrency: 1 });
      const { model } = analysis;
      const p = model.projection({ level: "file", fileRoles: new Set(["source"] as const) });
      out.push(`=== ${name}`);
      for (const path of focus) {
        const u = p.indexOf(`file:${path}`);
        const outs: string[] = [];
        for (let i = p.graph.outOffsets[u]!; i < p.graph.outOffsets[u + 1]!; i++) {
          const info = p.edgeInfoAt(i)!;
          outs.push(`${p.nodes[p.graph.outTargets[i]!]!.slice(5)}${info.runtimeEdgeCount > 0 ? "" : "[type]"}`);
        }
        const ins: string[] = [];
        for (const s of p.graph.predecessors(u)) {
          const info = p.edgeInfo(s, u)!;
          ins.push(`${p.nodes[s]!.slice(5)}${info.runtimeEdgeCount > 0 ? "" : "[type]"}`);
        }
        out.push(`  ${path}`);
        out.push(`    out (${outs.length}): ${outs.join(", ")}`);
        out.push(`    in  (${ins.length}): ${ins.join(", ")}`);
      }
    }
  } catch (error) {
    out.push(`ERROR ${String(error)} ${(error as Error).stack ?? ""}`);
  }
  writeFileSync(OUT, out.join("\n"));
});
