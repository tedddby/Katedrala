{
  "name": "@katedrala/linker",
  "version": "0.1.0",
  "description": "Katedrala linker: resolves per-file extractions into the structural architecture model (files, symbols, typed edges, packages, externals).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "katedrala-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "@katedrala/ir": "workspace:*",
    "@katedrala/plugin-api": "workspace:*"
  },
  "keywords": [
    "katedrala",
    "linker",
    "dependency-graph"
  ]
}
