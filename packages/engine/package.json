{
  "name": "@katedrala/engine",
  "version": "0.1.0",
  "description": "Katedrala analysis engine: runs the pipeline from a repository snapshot to an architecture document.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "katedrala-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "@katedrala/adapter-typescript": "workspace:*",
    "@katedrala/core": "workspace:*",
    "@katedrala/graph": "workspace:*",
    "@katedrala/ir": "workspace:*",
    "@katedrala/linker": "workspace:*",
    "@katedrala/model": "workspace:*",
    "@katedrala/plugin-api": "workspace:*",
    "zod": "4.6.5"
  },
  "keywords": [
    "katedrala",
    "architecture",
    "analysis"
  ]
}
