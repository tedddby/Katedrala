{
  "name": "@katedrala/graph",
  "version": "0.1.0",
  "description": "Compact immutable graphs and deterministic graph algorithms (SCC, reachability, centrality, PageRank, clustering).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "katedrala-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "devDependencies": {
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-components": "1.5.4",
    "graphology-metrics": "2.4.2",
    "graphology-shortest-path": "2.1.0",
    "graphology-types": "0.24.8"
  },
  "keywords": [
    "katedrala",
    "graph",
    "algorithms"
  ]
}
