{
  "name": "@katedrala/adapter-typescript",
  "version": "0.1.0",
  "description": "TypeScript and JavaScript language adapter for Katedrala (TypeScript 6 compiler API).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "katedrala-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "katedrala-source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "@katedrala/ir": "workspace:*",
    "@katedrala/plugin-api": "workspace:*",
    "typescript": "6.0.3"
  },
  "keywords": [
    "katedrala",
    "typescript",
    "javascript",
    "language-adapter"
  ]
}
